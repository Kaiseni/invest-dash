# Copiez ce fichier en ".env" puis adaptez-le :   cp .env.example .env

# OBLIGATOIRE : code commun demandé à toute personne qui crée un compte (y compris le premier = administrateur).
# Choisissez une phrase longue et donnez-la seulement aux personnes autorisées.
SIGNUP_CODE=changez-moi-par-une-longue-phrase-secrete

# Port publié sur la machine hôte et adresse d'écoute (127.0.0.1 = cette machine seulement ; 0.0.0.0 = réseau local)
PORT=5000
BIND=127.0.0.1

# Mettre 1 si l'application est derrière un reverse proxy (profil https, nginx...). NE PAS mettre 1 si elle est exposée directement.
TRUST_PROXY=0

# Nom utilisé par le profil https (Caddy)
SITE_ADDRESS=invest-dash.home.arpa

SESSION_IDLE_MIN=60
SESSION_MAX_HOURS=12
GAP_SCHEDULER=1
